APP_NAME=每日 AI 新闻助手
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./data/ai_news.db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_MAX_ROUNDS=15
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_SEARCH_CALLS=8
AGENT_MAX_FETCH_CALLS=10
AGENT_RESERVED_FINAL_CALLS=2
AGENT_SEARCH_TARGET_CANDIDATES=30
AGENT_TIMEOUT_SECONDS=300
WEB_SEARCH_PROVIDER=auto
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
DUCKDUCKGO_SEARCH_URL=https://html.duckduckgo.com/html/
BING_SEARCH_URL=https://www.bing.com/search
GITHUB_SEARCH_URL=https://api.github.com/search/repositories
REDDIT_SEARCH_URL=https://www.reddit.com/search.rss
# TwitterAPI.io：在这里粘贴 API Key；不要提交真实密钥
TWITTERAPI_API_KEY=
TWITTERAPI_SEARCH_URL=https://api.twitterapi.io/twitter/tweet/advanced_search
# 使用 Clash/TUN Fake-IP 模式时设为 true；仅放行 198.18.0.0/15
ALLOW_PROXY_FAKE_IP=false
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_DIGEST_HOUR=8
DEFAULT_DIGEST_MINUTE=0
DEFAULT_MAX_ITEMS=10
DEFAULT_COVERAGE_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

